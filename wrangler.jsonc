// Cloudflare Workers config (OpenNext adapter). The Worker name must match the project name in the
// Cloudflare dashboard — and the self-reference below must match it too, or deploys fail with error 10143.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save-the-date",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "save-the-date" }],
  "images": { "binding": "IMAGES" },
  // Public, non-sensitive settings only — this file is in a public repo.
  // Secrets (ADMIN_PASSWORD, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY) are set as encrypted
  // Secrets in the Cloudflare dashboard, or with `npx wrangler secret put NAME`; deploys never touch them.
  "vars": {
    "DEMO_MODE": "false",
    "NEXT_PUBLIC_SITE_URL": "https://www.doyinandakan.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://orishnnbfivtfvqhvxcf.supabase.co",
    "EMAIL_FROM": "Doyin & Akan <rsvp@doyinandakan.com>",
    "ADMIN_ALERT_EMAIL": "planner@doyinandakan.com"
  },
  // Keep anything else set in the dashboard instead of wiping it on each deploy.
  "keep_vars": true,
  // Guest chat assistant (/api/chat). ANTHROPIC_API_KEY is a dashboard Secret, never a var here.
  // Rate limiting bindings count across every isolate, unlike the in-memory limiter the route falls back to.
  // Cloudflare only offers 10- or 60-second windows, so these are per-minute ceilings; the route still keeps
  // its own 20-per-10-minutes and 2000-per-day counters on top. namespace_id is any integer unique to this account.
  "ratelimits": [
    { "name": "CHAT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHAT_GLOBAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // The strict counters: a Durable Object (lib/chat-limiter.ts, exported from worker.ts) holds the exact
  // 20-per-10-minutes-per-IP and 2000-per-day counts, which the bindings above only approximate.
  // SQLite-backed classes are available on every Workers plan; `wrangler deploy` applies the migration.
  "durable_objects": { "bindings": [{ "name": "CHAT_LIMITER", "class_name": "ChatLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatLimiter"] }],
  "observability": { "enabled": true }
}
